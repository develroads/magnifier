#!/usr/bin/env bash
# Smooth Magnifier engine setup.
#
# The zoom engine (hypr/magnifier.lua) runs inside Hyprland, so Hyprland's
# config has to load it. This script adds or removes one clearly marked block
# at the end of ~/.config/hypr/hyprland.lua. It changes nothing else, and it
# saves a timestamped backup next to the file before every change.
#
#   engine-setup status      prints "installed" or "not-installed"
#   engine-setup install     adds the block (or updates it in place)
#   engine-setup uninstall   removes the block
#
# The settings panel runs `install` only after you confirm it there.

set -euo pipefail

action="${1:-status}"
# Logical path (not -P): keeps ~/.config/omarchy/plugins/<id> even when that
# folder is a symlink to a development checkout.
plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
engine="$plugin_dir/hypr/magnifier.lua"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
begin="-- >>> smooth-magnifier >>>"
end="-- <<< smooth-magnifier <<<"

fail() { echo "engine-setup: $*" >&2; exit 1; }

has_block() { [[ -f $conf ]] && grep -qxF -- "$begin" "$conf"; }

# Copy of the config without our block.
without_block() {
  awk -v b="$begin" -v e="$end" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip { print }
  ' "$conf"
}

backup() {
  cp -p -- "$conf" "$conf.bak.smooth-magnifier.$(date +%s)"
}

# Replace the config in one rename, so Hyprland never reads half a file.
replace_conf() {
  local tmp
  tmp="$(mktemp "$conf.smooth-magnifier.XXXXXX")"
  cat >"$tmp"
  chmod --reference="$conf" "$tmp" 2>/dev/null || true
  mv -f -- "$tmp" "$conf"
}

case "$action" in
  status)
    if has_block; then echo installed; else echo not-installed; fi
    ;;

  install)
    [[ -f $conf ]] || fail "$conf not found"
    [[ -f $engine ]] || fail "$engine not found"
    # The path is written into Lua source, so allow only plain path characters.
    [[ $engine =~ ^[A-Za-z0-9._/+-]+$ ]] || fail "unsupported characters in plugin path: $engine"
    backup
    {
      without_block | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
      cat <<EOF

$begin
-- Smooth Magnifier zoom engine (Omarchy shell plugin). Remove this block, or
-- run engine-setup uninstall from the plugin folder, to turn it off.
do
  local engine = "$engine"
  local f = io.open(engine, "r")
  if f then
    f:close()
    local ok = pcall(dofile, engine)
    if not ok then hl.exec_cmd("notify-send 'Smooth Magnifier' 'The zoom engine failed to load'") end
  end
end
$end
EOF
    } | replace_conf
    echo installed
    ;;

  uninstall)
    if ! has_block; then echo not-installed; exit 0; fi
    backup
    without_block | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | replace_conf
    echo not-installed
    ;;

  *)
    fail "usage: engine-setup [status|install|uninstall]"
    ;;
esac
